---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    description: string;
    link: string;
    image: ImageMetadata;
    tags?: string[];
}

const { title, description, link, image, tags = [] } = Astro.props;
---

<article class="flex flex-col md:flex-row gap-6 bg-gray-800/40 border border-gray-700/60 rounded-2xl p-5 hover:border-gray-500/80 transition-all duration-300 hover:bg-gray-800/70 shadow-lg">
  <!-- Imagen con enlace reutilizable -->
  <a 
    href={link} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="w-full md:w-2/5 overflow-hidden rounded-xl block group aspect-video md:aspect-auto"
  >
    <Image 
      src={image} 
      alt={`Captura de pantalla del proyecto ${title}`} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
    />
  </a>

  <!-- Contenido de la tarjeta -->
  <div class="w-full md:w-3/5 flex flex-col justify-between py-1">
    <div>
      <h3 class="text-xl font-bold text-white mb-2">{title}</h3>
      <p class="text-gray-300 text-sm leading-relaxed mb-4 opacity-90">{description}</p>
      
      <!-- Etiquetas de tecnologías (opcional) -->
      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <li class="text-xs bg-gray-700/60 text-gray-200 px-2.5 py-1 rounded-md border border-gray-600/50">
              {tag}
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Enlace / Botón -->
    <div class="mt-2">
      <a 
        href={link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-x-2 text-sm text-blue-400 hover:text-blue-300 font-medium group"
      >
        <span>Ver proyecto</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>